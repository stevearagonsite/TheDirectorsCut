#!/bin/sh
# Bloquea commits con secretos. Activar con: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "[pre-commit] gitleaks no está instalado. Mac: brew install gitleaks | Windows: winget install Gitleaks.Gitleaks" >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner --config .gitleaks.toml || {
  echo "[pre-commit] gitleaks encontró posibles secretos. Commit bloqueado." >&2
  exit 1
}
